digraph ER {
graph [rankdir=LR, splines=true, nodesep=0.35, ranksep=1.1, fontname="Helvetica", label="BookOrbit AI - E-R diagram of the implemented system (one entity = one data/*.txt file; underlined = key)", labelloc=t, fontsize=18];
node [shape=plaintext, fontname="Helvetica", fontsize=10];
edge [fontname="Helvetica", fontsize=9, color="#4B5563", arrowhead=none];
User [label=<<table border="0" cellborder="1" cellspacing="0" cellpadding="3" bgcolor="white"><tr><td bgcolor="#1E2A44" align="left"><font color="white"><b>User</b></font><font color="#E8B04A" point-size="9">  users.txt</font></td></tr><tr><td align="left"><u><b>user_ID</b></u><font color="#8A5A00" point-size="9"> PK</font></td></tr><tr><td align="left">username (unique)</td></tr><tr><td align="left">full_Name</td></tr><tr><td align="left">email</td></tr><tr><td align="left">role {RC, VC, SU}</td></tr><tr><td align="left">status {ACTIVE, SUSPENDED}</td></tr><tr><td align="left">balance</td></tr><tr><td align="left">warnings</td></tr><tr><td align="left">purchase_Count</td></tr><tr><td align="left">total_Spent</td></tr><tr><td align="left">promo_Purchases</td></tr><tr><td align="left">promo_Spent</td></tr><tr><td align="left">suspension_Reason</td></tr><tr><td align="left">created_At</td></tr></table>>];
Book [label=<<table border="0" cellborder="1" cellspacing="0" cellpadding="3" bgcolor="white"><tr><td bgcolor="#1E2A44" align="left"><font color="white"><b>Book</b></font><font color="#E8B04A" point-size="9">  books.txt</font></td></tr><tr><td align="left"><u><b>book_ID</b></u><font color="#8A5A00" point-size="9"> PK</font></td></tr><tr><td align="left">title</td></tr><tr><td align="left">author</td></tr><tr><td align="left">category</td></tr><tr><td align="left">keywords</td></tr><tr><td align="left">description</td></tr><tr><td align="left">pub_Year</td></tr><tr><td align="left">price</td></tr><tr><td align="left">cover_Path</td></tr><tr><td align="left">text_Path</td></tr><tr><td align="left">browse_Count</td></tr><tr><td align="left">purchase_Count</td></tr><tr><td align="left">rating_Count</td></tr><tr><td align="left">weighted_Avg</td></tr><tr><td align="left">list_Status {NONE, NO_ORDER, TO_ORDER}</td></tr><tr><td align="left">indexed</td></tr><tr><td align="left">added_At</td></tr></table>>];
Transaction [label=<<table border="0" cellborder="1" cellspacing="0" cellpadding="3" bgcolor="white"><tr><td bgcolor="#1E2A44" align="left"><font color="white"><b>Transaction</b></font><font color="#E8B04A" point-size="9">  transactions.txt</font></td></tr><tr><td align="left"><u><b>txn_ID</b></u><font color="#8A5A00" point-size="9"> PK</font></td></tr><tr><td align="left">user_ID<font color="#8A5A00" point-size="9"> FK</font></td></tr><tr><td align="left">book_ID<font color="#8A5A00" point-size="9"> FK</font></td></tr><tr><td align="left">type {DEPOSIT, PURCHASE, FINE}</td></tr><tr><td align="left">amount</td></tr><tr><td align="left">balance_After</td></tr><tr><td align="left">note</td></tr><tr><td align="left">created_At</td></tr></table>>];
Purchase [label=<<table border="0" cellborder="1" cellspacing="0" cellpadding="3" bgcolor="white"><tr><td bgcolor="#1E2A44" align="left"><font color="white"><b>Purchase</b></font><font color="#E8B04A" point-size="9">  purchases.txt</font></td></tr><tr><td align="left"><u><b>purchase_ID</b></u><font color="#8A5A00" point-size="9"> PK</font></td></tr><tr><td align="left">user_ID<font color="#8A5A00" point-size="9"> FK</font></td></tr><tr><td align="left">book_ID<font color="#8A5A00" point-size="9"> FK</font></td></tr><tr><td align="left">txn_ID<font color="#8A5A00" point-size="9"> FK</font></td></tr><tr><td align="left">list_Price</td></tr><tr><td align="left">discount</td></tr><tr><td align="left">paid</td></tr><tr><td align="left">created_At</td></tr></table>>];
Review [label=<<table border="0" cellborder="1" cellspacing="0" cellpadding="3" bgcolor="white"><tr><td bgcolor="#1E2A44" align="left"><font color="white"><b>Review</b></font><font color="#E8B04A" point-size="9">  reviews.txt</font></td></tr><tr><td align="left"><u><b>review_ID</b></u><font color="#8A5A00" point-size="9"> PK</font></td></tr><tr><td align="left">book_ID<font color="#8A5A00" point-size="9"> FK</font></td></tr><tr><td align="left">user_ID<font color="#8A5A00" point-size="9"> FK (null = Visitor)</font></td></tr><tr><td align="left">visitor_Key</td></tr><tr><td align="left">author_Name</td></tr><tr><td align="left">role_At_Time</td></tr><tr><td align="left">rating 1-5</td></tr><tr><td align="left">original_Text</td></tr><tr><td align="left">display_Text</td></tr><tr><td align="left">taboo_Count</td></tr><tr><td align="left">weight 1.0 / 2.0</td></tr><tr><td align="left">verified_Buyer</td></tr><tr><td align="left">status {PUBLISHED, BLOCKED}</td></tr><tr><td align="left">created_At</td></tr><tr><td align="left">updated_At</td></tr></table>>];
Warning [label=<<table border="0" cellborder="1" cellspacing="0" cellpadding="3" bgcolor="white"><tr><td bgcolor="#1E2A44" align="left"><font color="white"><b>Warning</b></font><font color="#E8B04A" point-size="9">  warnings.txt</font></td></tr><tr><td align="left"><u><b>warning_ID</b></u><font color="#8A5A00" point-size="9"> PK</font></td></tr><tr><td align="left">user_ID<font color="#8A5A00" point-size="9"> FK</font></td></tr><tr><td align="left">review_ID<font color="#8A5A00" point-size="9"> FK</font></td></tr><tr><td align="left">reason</td></tr><tr><td align="left">created_At</td></tr></table>>];
TabooWord [label=<<table border="0" cellborder="1" cellspacing="0" cellpadding="3" bgcolor="white"><tr><td bgcolor="#1E2A44" align="left"><font color="white"><b>TabooWord</b></font><font color="#E8B04A" point-size="9">  taboo_words.txt</font></td></tr><tr><td align="left"><u><b>word</b></u><font color="#8A5A00" point-size="9"> PK</font></td></tr><tr><td align="left">added_By<font color="#8A5A00" point-size="9"> FK</font></td></tr><tr><td align="left">added_At</td></tr></table>>];
FaceTemplate [label=<<table border="0" cellborder="1" cellspacing="0" cellpadding="3" bgcolor="white"><tr><td bgcolor="#1E2A44" align="left"><font color="white"><b>FaceTemplate</b></font><font color="#E8B04A" point-size="9">  biometrics.txt</font></td></tr><tr><td align="left"><u><b>user_ID</b></u><font color="#8A5A00" point-size="9"> PK/FK</font></td></tr><tr><td align="left">template_Path</td></tr><tr><td align="left">detector</td></tr><tr><td align="left">embedder</td></tr><tr><td align="left">samples</td></tr><tr><td align="left">created_At</td></tr></table>>];
LoginAttempt [label=<<table border="0" cellborder="1" cellspacing="0" cellpadding="3" bgcolor="white"><tr><td bgcolor="#1E2A44" align="left"><font color="white"><b>LoginAttempt</b></font><font color="#E8B04A" point-size="9">  login_attempts.txt</font></td></tr><tr><td align="left"><u><b>attempt_ID</b></u><font color="#8A5A00" point-size="9"> PK</font></td></tr><tr><td align="left">user_ID<font color="#8A5A00" point-size="9"> FK</font></td></tr><tr><td align="left">username</td></tr><tr><td align="left">score</td></tr><tr><td align="left">success</td></tr><tr><td align="left">created_At</td></tr></table>>];
BrowseEvent [label=<<table border="0" cellborder="1" cellspacing="0" cellpadding="3" bgcolor="white"><tr><td bgcolor="#1E2A44" align="left"><font color="white"><b>BrowseEvent</b></font><font color="#E8B04A" point-size="9">  browse_history.txt</font></td></tr><tr><td align="left"><u><b>event_ID</b></u><font color="#8A5A00" point-size="9"> PK</font></td></tr><tr><td align="left">user_ID<font color="#8A5A00" point-size="9"> FK</font></td></tr><tr><td align="left">book_ID<font color="#8A5A00" point-size="9"> FK</font></td></tr><tr><td align="left">action VIEW</td></tr><tr><td align="left">created_At</td></tr></table>>];
ChatMessage [label=<<table border="0" cellborder="1" cellspacing="0" cellpadding="3" bgcolor="white"><tr><td bgcolor="#1E2A44" align="left"><font color="white"><b>ChatMessage</b></font><font color="#E8B04A" point-size="9">  chat_log.txt</font></td></tr><tr><td align="left"><u><b>chat_ID</b></u><font color="#8A5A00" point-size="9"> PK</font></td></tr><tr><td align="left">user_ID<font color="#8A5A00" point-size="9"> FK (null = Visitor)</font></td></tr><tr><td align="left">role</td></tr><tr><td align="left">question</td></tr><tr><td align="left">intent</td></tr><tr><td align="left">answer</td></tr><tr><td align="left">source {RAG, LLM, ADMIN, ACCOUNT, DENIED, OFFLINE}</td></tr><tr><td align="left">created_At</td></tr></table>>];
ReadingProgress [label=<<table border="0" cellborder="1" cellspacing="0" cellpadding="3" bgcolor="white"><tr><td bgcolor="#1E2A44" align="left"><font color="white"><b>ReadingProgress</b></font><font color="#E8B04A" point-size="9">  reading_progress.txt</font></td></tr><tr><td align="left"><u><b>user_ID</b></u><font color="#8A5A00" point-size="9"> PK/FK</font></td></tr><tr><td align="left"><u><b>book_ID</b></u><font color="#8A5A00" point-size="9"> PK/FK</font></td></tr><tr><td align="left">chapter</td></tr><tr><td align="left">last_Action</td></tr><tr><td align="left">updated_At</td></tr></table>>];
StatusChange [label=<<table border="0" cellborder="1" cellspacing="0" cellpadding="3" bgcolor="white"><tr><td bgcolor="#1E2A44" align="left"><font color="white"><b>StatusChange</b></font><font color="#E8B04A" point-size="9">  status_changes.txt</font></td></tr><tr><td align="left"><u><b>change_ID</b></u><font color="#8A5A00" point-size="9"> PK</font></td></tr><tr><td align="left">user_ID<font color="#8A5A00" point-size="9"> FK</font></td></tr><tr><td align="left">from_Role</td></tr><tr><td align="left">to_Role</td></tr><tr><td align="left">from_Status</td></tr><tr><td align="left">to_Status</td></tr><tr><td align="left">reason</td></tr><tr><td align="left">by (SYSTEM or SU)<font color="#8A5A00" point-size="9"> FK</font></td></tr><tr><td align="left">created_At</td></tr></table>>];
AdminAction [label=<<table border="0" cellborder="1" cellspacing="0" cellpadding="3" bgcolor="white"><tr><td bgcolor="#1E2A44" align="left"><font color="white"><b>AdminAction</b></font><font color="#E8B04A" point-size="9">  admin_actions.txt</font></td></tr><tr><td align="left"><u><b>action_ID</b></u><font color="#8A5A00" point-size="9"> PK</font></td></tr><tr><td align="left">admin_ID<font color="#8A5A00" point-size="9"> FK</font></td></tr><tr><td align="left">action</td></tr><tr><td align="left">target</td></tr><tr><td align="left">details</td></tr><tr><td align="left">created_At</td></tr></table>>];
RagChunk [label=<<table border="0" cellborder="1" cellspacing="0" cellpadding="3" bgcolor="white"><tr><td bgcolor="#1E2A44" align="left"><font color="white"><b>RagChunk</b></font><font color="#E8B04A" point-size="9">  rag_chunks.txt</font></td></tr><tr><td align="left"><u><b>chunk_ID</b></u><font color="#8A5A00" point-size="9"> PK</font></td></tr><tr><td align="left">scope {PUBLIC, BOOK_TEXT}</td></tr><tr><td align="left">book_ID<font color="#8A5A00" point-size="9"> FK</font></td></tr><tr><td align="left">title</td></tr><tr><td align="left">text</td></tr></table>>];
User -> Transaction [label="has ledger", taillabel="1", headlabel="0..*", labeldistance=1.6];
User -> Purchase [label="buys", taillabel="1", headlabel="0..*", labeldistance=1.6];
Book -> Purchase [label="is bought in", taillabel="1", headlabel="0..*", labeldistance=1.6];
Purchase -> Transaction [label="paid by", taillabel="1", headlabel="1", labeldistance=1.6];
User -> Review [label="writes", taillabel="0..1", headlabel="0..*", labeldistance=1.6];
Book -> Review [label="receives", taillabel="1", headlabel="0..*", labeldistance=1.6];
Review -> Warning [label="causes", taillabel="1", headlabel="0..1", labeldistance=1.6];
User -> Warning [label="receives", taillabel="1", headlabel="0..*", labeldistance=1.6];
User -> FaceTemplate [label="enrols", taillabel="1", headlabel="0..1", labeldistance=1.6];
User -> LoginAttempt [label="attempts", taillabel="1", headlabel="0..*", labeldistance=1.6];
User -> BrowseEvent [label="views", taillabel="1", headlabel="0..*", labeldistance=1.6];
Book -> BrowseEvent [label="is viewed", taillabel="1", headlabel="0..*", labeldistance=1.6];
User -> ChatMessage [label="asks", taillabel="0..1", headlabel="0..*", labeldistance=1.6];
User -> ReadingProgress [label="reads", taillabel="1", headlabel="0..*", labeldistance=1.6];
Book -> ReadingProgress [label="is read", taillabel="1", headlabel="0..*", labeldistance=1.6];
User -> StatusChange [label="changes", taillabel="1", headlabel="0..*", labeldistance=1.6];
User -> AdminAction [label="performs (SU)", taillabel="1", headlabel="0..*", labeldistance=1.6];
User -> TabooWord [label="maintains (SU)", taillabel="1", headlabel="0..*", labeldistance=1.6];
Book -> RagChunk [label="is split into", taillabel="0..1", headlabel="0..*", labeldistance=1.6];
}